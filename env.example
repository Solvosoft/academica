# Copiar a .env (desarrollo local con `make run`) o a deploy/academica.env
# (docker compose). `make env` crea ambos si no existen.

DEBUG=True
SECRET_KEY=cambiar-esta-clave-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_SCHEME=http

# PostgreSQL (`make services` lo publica en el puerto 5433; en docker compose el host es "postgresdb")
DBNAME=academica
DBUSER=academica_user
DBPASSWORD=NOUSARENPROD
DBHOST=127.0.0.1
DBPORT=5433
DBTESTNAME=test_academica
POSTGRES_DB=academica
POSTGRES_USER=academica_user
POSTGRES_PASSWORD=NOUSARENPROD

# Celery (en docker compose: redis://redis:6379/0)
BROKER_URL=redis://localhost:6379/0

# Correo (`make services` publica MailHog en 1026, web en http://localhost:8026)
EMAIL_HOST=localhost
EMAIL_PORT=1026
DEFAULT_FROM_EMAIL=webmaster@localhost
# ASYNC_SEND_ONLY_EMAIL=pruebas@example.com

# PayPal
PAYPAL_TEST=True
MY_PAYPAL_HOST=http://localhost:8011

# Contenedores
SERVICE_TYPE=web
ACADEMICA_BOOT_INSTALL=true
