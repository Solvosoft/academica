# Copiar a .env (desarrollo local con `make run`) o a deploy/academica.env
# (docker compose). `make env` crea ambos si no existen.

DEBUG=True
SECRET_KEY=cambiar-esta-clave-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_SCHEME=http

# PostgreSQL (`make services` lo publica en el puerto 5433; en docker compose el host es "postgresdb")
DBNAME=academica
DBUSER=academica_user
DBPASSWORD=NOUSARENPROD
DBHOST=127.0.0.1
DBPORT=5433
DBTESTNAME=test_academica
POSTGRES_DB=academica
POSTGRES_USER=academica_user
POSTGRES_PASSWORD=NOUSARENPROD

# Celery (en docker compose: redis://redis:6379/0)
BROKER_URL=redis://localhost:6379/0

# Correo (`make services` publica MailHog en 1026, web en http://localhost:8026)
EMAIL_HOST=localhost
EMAIL_PORT=1026
DEFAULT_FROM_EMAIL=webmaster@localhost
# ASYNC_SEND_ONLY_EMAIL=pruebas@example.com

# PayPal
PAYPAL_TEST=True
MY_PAYPAL_HOST=http://localhost:8011

# Pago con tarjeta (servicio webcheckout, repositorio payments). Sin token ni
# business id la opción de tarjeta no se muestra.
SITE_BASE_URL=http://localhost:8011
WEBCHECKOUT_BASE_URL=https://payments.dev.solvosoft.com
WEBCHECKOUT_API_TOKEN=
WEBCHECKOUT_BUSINESS_ID=
# Igual al id_token del Business en el servicio (autentica las notificaciones)
WEBCHECKOUT_NOTIFICATION_TOKEN=

# Contenedores
SERVICE_TYPE=web
ACADEMICA_BOOT_INSTALL=true
# Workers de gunicorn del rol web (deploy/gunicorn_start)
GUNICORN_WORKERS=2
CELERY_CONCURRENCY=2

# Errores a GlitchTip (vacío = desactivado; tampoco se usa con DEBUG=True)
GLITCHTIP_DSN=
LOG_LEVEL=INFO

# Administrador que crea deploy/install.sh (lo lanza el AppPack de la
# plataforma). Solo si no existe ningún superusuario.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
